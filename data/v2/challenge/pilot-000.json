  "messages": [
    {
      "id": "pilot-000-m0000",
      "period": 36,
      "sender": "Supplier A planning",
      "sender_class": "supplier_planning",
      "channel": "email",
      "text": "Subject: Plant 2 capacity, Sept/Oct\n\nHello planning team,\n\nWe have a scheduled overhaul of the press line at Plant 2. Between 14 September and 11 October, Plant 2 will be running at 25% less than its normal capacity. Please plan your call-offs with that in mind.\n\nRegards,\nMartin Kowalski\nSupplier A, Production Planning"
    },
    {
      "id": "pilot-000-m0001",
      "period": 36,
      "sender": "Supplier B planning",
      "sender_class": "supplier_planning",
      "channel": "portal",
      "text": "Portal notice ref. SB-2026-0417: Plant 4 will have 15% more capacity than usual from week 38 through week 40, as we have extra staff on the second shift for that period. Any questions to Ana on ext. 2214."
    },
    {
      "id": "pilot-000-m0002",
      "period": 37,
      "sender": "Procurement",
      "sender_class": "procurement",
      "channel": "email",
      "text": "Hi all,\n\nFollowing the outcome of last week's supplier review, and after discussion with finance and the category managers, it has been decided that, with immediate effect and until further notice, Supplier C is suspended and no new orders are to be placed with them.\n\nThanks,\nPriya (Procurement)"
    },
    {
      "id": "pilot-000-m0003",
      "period": 37,
      "sender": "Carrier ops",
      "sender_class": "carrier",
      "channel": "carrier",
      "text": "Carrier update: because of berth works at Port X, shipments from Plant 1 routed through Port X will take 10 days longer in transit from week 39 until the end of week 42. The Port Z lane from Plant 3 is not affected and keeps its usual transit time."
    },
    {
      "id": "pilot-000-m0004",
      "period": 39,
      "sender": "Sales ops",
      "sender_class": "sales",
      "channel": "email",
      "text": "hi team, quick one. SKU-02 orders will be 30% lower than normal for wk42 + wk43 only, biggest customer is working through their own stock. back to normal after that. thx, Jo"
    },
    {
      "id": "pilot-000-m0005",
      "period": 39,
      "sender": "Ops desk",
      "sender_class": "internal",
      "channel": "email",
      "text": "Hi all, FYI the cycle count on Lot 7702 is done: 480 cases of SKU-02, which matches the system. Nothing for planning to action. Cheers, Sam (Ops desk)"
    },
    {
      "id": "pilot-000-m0006",
      "period": 40,
      "sender": "Supplier C billing",
      "sender_class": "supplier_finance",
      "channel": "email",
      "text": "Dear customer,\n\nPlease note that, due to higher raw material costs, the Supplier C price for SKU-03 will increase by 5% from 5 October 2026. The new price applies until further notice.\n\nKind regards,\nSupplier C Billing"
    },
    {
      "id": "pilot-000-m0007",
      "period": 40,
      "sender": "Ops desk",
      "sender_class": "internal",
      "channel": "email",
      "text": "Morning, weekly check-in from the ops desk: order plan for SKU-01 unchanged, and the Port Z lane is running without delays. Nothing new this week. Sam"
    },
    {
      "id": "pilot-000-m0008",
      "period": 41,
      "sender": "Carrier ops",
      "sender_class": "carrier",
      "channel": "carrier",
      "text": "Booking desk notice #88213: the lane through Port Z for shipments from Plant 3 is now 5 days quicker, since we have switched to a direct sailing. This applies from this week (wk 41) to the end of week 49. Questions to the booking desk on ext. 6150."
    },
    {
      "id": "pilot-000-m0009",
      "period": 41,
      "sender": "Supplier B planning",
      "sender_class": "supplier_planning",
      "channel": "email",
      "text": "Good afternoon,\n\nAs part of the annual safety inspection programme, which this year has been scheduled together with the replacement of the cooling system, the available capacity of Plant 3 will be reduced by 20% from week 44 through week 45.\n\nBest regards,\nTomas, Supplier B Planning"
    },
    {
      "id": "pilot-000-m0010",
      "period": 42,
      "sender": "Procurement",
      "sender_class": "procurement",
      "channel": "email",
      "text": "Hi all, the suspension of Supplier C that we announced in week 37 is lifted with immediate effect. Supplier C is active again and orders can be placed as normal. Thanks, Priya"
    },
    {
      "id": "pilot-000-m0011",
      "period": 43,
      "sender": "QA",
      "sender_class": "supplier_quality",
      "channel": "email",
      "text": "Hello,\n\nQA has placed Lot 7702 (SKU-02) on quality hold, effective now and until further notice, pending lab results on a seal defect. Lot 7701 of SKU-01 is not affected and can be used as normal.\n\nRegards,\nHelen, QA"
    },
    {
      "id": "pilot-000-m0012",
      "period": 43,
      "sender": "Ops desk",
      "sender_class": "internal",
      "channel": "portal",
      "text": "Ops desk note: all 12 containers booked on the Port X lane out of Plant 1 this week are confirmed. Nothing else to report."
    },
    {
      "id": "pilot-000-m0013",
      "period": 44,
      "sender": "QA",
      "sender_class": "supplier_quality",
      "channel": "email",
      "text": "fyi QA put lot 7701 (SKU-01) on hold as of today, until further notice. pls don't ship from it. thx, Helen"
    },
    {
      "id": "pilot-000-m0014",
      "period": 44,
      "sender": "Sales ops",
      "sender_class": "sales",
      "channel": "email",
      "text": "Hi planning,\n\nHeads-up for SKU-03: customer orders for the week of 9 November (9 to 15 November) will be 30% lower than usual. It's a one-off, and the following week should be back to normal.\n\nBest, Jo"
    },
    {
      "id": "pilot-000-m0015",
      "period": 44,
      "sender": "Ops desk",
      "sender_class": "internal",
      "channel": "email",
      "text": "Hi all, nothing to flag from the ops desk this week. No disruption expected at Plant 4, and the SKU-02 order plan stays unchanged. Sam"
    },
    {
      "id": "pilot-000-m0016",
      "period": 46,
      "sender": "Carrier ops",
      "sender_class": "carrier",
      "channel": "carrier",
      "text": "Carrier ops, case 51-7730: while the regular vessel is in dry dock, transit on the Port X lane (shipments from Plant 1) will be 14 days longer from week 49 to week 50 inclusive. For bookings call 0800 555 2190."
    },
    {
      "id": "pilot-000-m0017",
      "period": 46,
      "sender": "Supplier B billing",
      "sender_class": "supplier_finance",
      "channel": "email",
      "text": "Dear customer,\n\nFollowing our annual review of energy and freight costs, and in line with the terms of our supply agreement, the price charged by Supplier B for SKU-02 will be increased by 6% from week 49 (30 November) until further notice.\n\nKind regards,\nSupplier B Billing"
    },
    {
      "id": "pilot-000-m0018",
      "period": 47,
      "sender": "Supplier A planning",
      "sender_class": "supplier_planning",
      "channel": "email",
      "text": "Hi,\n\nPlant 2 will have 25% less capacity than normal in weeks 49 and 50 while we install the new furnace. Plant 1 is not affected.\n\nMartin, Supplier A Planning"
    },
    {
      "id": "pilot-000-m0019",
      "period": 48,
      "sender": "QA",
      "sender_class": "supplier_quality",
      "channel": "email",
      "text": "Hello all, the quality hold on Lot 7701 (SKU-01) from week 44 is now lifted. Tests came back fine, so the lot is released and can be used again from this week. Regards, Helen (QA)"
    }
