  "messages": [
    {
      "id": "pilot-021-m0000",
      "period": 37,
      "sender": "Supplier A planning",
      "sender_class": "supplier_planning",
      "channel": "email",
      "text": "Hi team,\n\nPlant 2 will be at 10% below normal capacity from week 39 to week 42 while one of the lines is refurbished. Nothing changes at Plant 1, which keeps running as normal.\n\nThanks,\nGreta, Supplier A Planning"
    },
    {
      "id": "pilot-021-m0001",
      "period": 37,
      "sender": "Sales ops",
      "sender_class": "sales",
      "channel": "email",
      "text": "quick heads up, SKU-01 orders up 10% next wk (wk38) only, customer doing a one-off restock. normal again wk39. Raj"
    },
    {
      "id": "pilot-021-m0002",
      "period": 37,
      "sender": "Supplier A billing",
      "sender_class": "supplier_finance",
      "channel": "email",
      "text": "Dear Sir/Madam,\n\nSupplier A will raise its price for SKU-01 by 5% with effect from 28 September 2026. The new price will stay in place until further notice.\n\nYours faithfully,\nAccounts, Supplier A"
    },
    {
      "id": "pilot-021-m0003",
      "period": 38,
      "sender": "Supplier C billing",
      "sender_class": "supplier_finance",
      "channel": "email",
      "text": "Hello,\n\nYour account no. 100482. Supplier C's price for SKU-01 is reduced by 2% from week 39 until further notice. Questions to the billing desk, ext. 5520.\n\nBest,\nOmar, Supplier C Billing"
    },
    {
      "id": "pilot-021-m0004",
      "period": 38,
      "sender": "Sales ops",
      "sender_class": "sales",
      "channel": "email",
      "text": "Hi all,\n\nAfter a review of the latest customer forecasts with the key account team, and taking into account the slower season our main distributor has warned us about, customer orders for SKU-03 are expected to be 15% lower from week 41 through week 43.\n\nBest,\nRaj"
    },
    {
      "id": "pilot-021-m0005",
      "period": 39,
      "sender": "Procurement",
      "sender_class": "procurement",
      "channel": "email",
      "text": "Hello,\n\nFollowing a failed audit, Supplier B is suspended with immediate effect and until further notice: please do not place any new orders with them. Supplier A and Supplier C are not affected.\n\nRegards,\nProcurement"
    },
    {
      "id": "pilot-021-m0006",
      "period": 39,
      "sender": "Ops desk",
      "sender_class": "internal",
      "channel": "email",
      "text": "Hi all, quiet week at the ops desk. Order plan for SKU-02 unchanged, no delays to report. Lucy"
    },
    {
      "id": "pilot-021-m0007",
      "period": 40,
      "sender": "Carrier ops",
      "sender_class": "carrier",
      "channel": "carrier",
      "text": "FYI Port Z lane (from Plant 3) is gonna be 7 days slower from wk41, til further notice. port's short on cranes. carrier ops"
    },
    {
      "id": "pilot-021-m0008",
      "period": 41,
      "sender": "Supplier B planning",
      "sender_class": "supplier_planning",
      "channel": "portal",
      "text": "Notice from Supplier B: between 26 October and 15 November, Plant 4 will produce at 15% below its normal capacity due to equipment upgrades."
    },
    {
      "id": "pilot-021-m0009",
      "period": 43,
      "sender": "Procurement",
      "sender_class": "procurement",
      "channel": "email",
      "text": "Hi all,\n\nWe are withdrawing the suspension of Supplier B issued in week 39. Supplier B is reinstated with effect from this week, and orders can be placed normally again.\n\nThanks, Procurement"
    },
    {
      "id": "pilot-021-m0010",
      "period": 43,
      "sender": "Procurement",
      "sender_class": "procurement",
      "channel": "email",
      "text": "Hello,\n\nCase no. 2026-118. Supplier C is suspended from today until further notice, and no new orders will be accepted. Contact: procurement desk, ext. 7731."
    },
    {
      "id": "pilot-021-m0011",
      "period": 45,
      "sender": "QA",
      "sender_class": "supplier_quality",
      "channel": "quality",
      "text": "Quality notice: following a customer complaint about discolouration and the preliminary findings from the lab, which are still being reviewed, Lot 7703 (SKU-03) has been placed on quality hold with immediate effect until further notice."
    },
    {
      "id": "pilot-021-m0012",
      "period": 45,
      "sender": "Ops desk",
      "sender_class": "internal",
      "channel": "portal",
      "text": "Ops desk update: 6 trucks left Plant 2 this week as planned. No other news."
    },
    {
      "id": "pilot-021-m0013",
      "period": 46,
      "sender": "Procurement",
      "sender_class": "procurement",
      "channel": "email",
      "text": "Hi all,\n\nFollowing repeated quality issues, Supplier B is suspended again from this week until further notice, and no new orders should be placed with them. Supplier A is not affected; orders to Supplier A continue as normal.\n\nProcurement"
    },
    {
      "id": "pilot-021-m0014",
      "period": 47,
      "sender": "Supplier A planning",
      "sender_class": "supplier_planning",
      "channel": "email",
      "text": "hey all, Plant 1 down 15% capacity wk48 thru wk50, maintenance shutdown on one line. back to normal after. Greta (Supp A)"
    },
    {
      "id": "pilot-021-m0015",
      "period": 49,
      "sender": "QA",
      "sender_class": "supplier_quality",
      "channel": "email",
      "text": "Hello,\n\nThe quality hold placed on Lot 7703 (SKU-03) in week 45 has been lifted. The lot is released from this week and can be used and shipped as normal.\n\nBest regards, QA"
    }
